<?xml version='1.0' encoding='utf-8'?>
<robot name="agv_chassis">
  <material name="chassis_gray">
    <color rgba="0.35 0.37 0.40 1.0" />
  </material>
  <material name="wheel_gray">
    <color rgba="0.16 0.17 0.19 1.0" />
  </material>
  <material name="sensor_gray">
    <color rgba="0.18 0.19 0.21 1.0" />
  </material>
  <material name="camera_silver">
    <color rgba="0.85 0.87 0.90 1.0" />
  </material>
  <link name="base_footprint" />
  <!-- Retain the existing IMU mount until measured on this chassis.
       (暂沿用现有 IMU 安装参数，实车测量后可在此调整。) -->
  <link name="imu_link" />
  <joint name="imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0.04 -0.015 -0.110" rpy="0 0 1.57" />
  </joint>
  <!-- Keep scan consumers on lidar_frame (保持雷达消费者的坐标系名称). -->
  <link name="lidar_frame" />
  <joint name="lidar_frame_joint" type="fixed">
    <parent link="lidar_link" />
    <child link="lidar_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <!-- Camera optical convention: right, down, forward (光学坐标：右、下、前). -->
  <link name="camera_link0" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_link0" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <link name="depth_cam_frame" />
  <joint name="depth_cam_frame_joint" type="fixed">
    <parent link="camera_link0" />
    <child link="depth_cam_frame" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
